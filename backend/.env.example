# Copiar este archivo como .env y llenar los valores. El .env NO se sube a git.

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Oracle 19c (servidor actual del sistema Java: lh.puerto.quetzal)
DB_HOST=lh.puerto.quetzal
DB_PORT=1521
DB_SERVICE=EPQ
DB_USER=
DB_PASSWORD=

# Carpeta de Oracle Instant Client (modo thick). Requerido mientras el usuario de BD
# tenga verificador de clave 10G (error NJS-116). Vacío = modo thin.
ORACLE_CLIENT_DIR=

# JWT: usar una cadena larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRA=8h

# Clave temporal que obliga al usuario a cambiarla al entrar
CLAVE_INICIAL=nuevosistema*20

# Servicio de auditoría (opcional; vacío = desactivado). Debe incluir http:// o https://
BITACORA_URL=
